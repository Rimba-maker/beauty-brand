---
import { BRAND } from '~/data/content';
import Icon from './Icon.astro';
---
<div class="announcement">Skin-first. Botanical-powered. Beautifully you. <a href="#ingredients">Meet our ingredients <Icon name="arrow" /></a></div>
<header class="site-header">
  <nav aria-label="Main navigation">
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu" /></button>
    <div class="desktop-links"><a href="#products">The collection</a><a href="#story">Our philosophy</a></div>
    <a href="#home" class="wordmark" aria-label="DEWY CO. home">dewy co<span>.</span></a>
    <div class="nav-right"><a class="journal-link" href="#journal">The journal</a><button class="bag-toggle" data-open-bag aria-label="Open shopping bag"><Icon name="bag" /><span>Bag (<span data-bag-count>0</span>)</span></button></div>
  </nav>
  <div id="mobile-menu" hidden>
    {BRAND.navLinks.map(link => <a href={link.href}>{link.label}<Icon name="arrow" /></a>)}
    <button data-open-quiz>Find your ritual<Icon name="arrow" /></button>
  </div>
</header>
<style>
  .announcement{height:34px;background:var(--color-espresso);color:var(--color-paper);display:flex;justify-content:center;align-items:center;gap:26px;font-size:10px;letter-spacing:.025em}
  .announcement a{display:flex;gap:8px;align-items:center}.announcement :global(svg){width:13px;height:13px}
  .site-header{position:sticky;top:0;z-index:40;background:var(--color-paper)}
  nav{height:88px;max-width:1560px;padding-inline:5vw;margin:auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
  .desktop-links,.nav-right{display:flex;align-items:center;gap:30px;font-size:11px}.nav-right{justify-content:flex-end}
  .desktop-links a,.journal-link{padding-block:14px;position:relative}.desktop-links a::after,.journal-link::after{content:'';height:1px;background:currentColor;position:absolute;bottom:10px;left:0;right:100%;transition:right .25s}.desktop-links a:hover::after,.journal-link:hover::after{right:0}
  .wordmark{font-family:var(--font-display);font-size:46px;line-height:1;letter-spacing:-.04em}.wordmark span{color:var(--color-plum)}
  .bag-toggle,.menu-toggle{border:0;background:none;min-height:44px;display:flex;align-items:center;justify-content:center;gap:10px;font-size:11px;padding:0 4px}.menu-toggle{display:none}
  #mobile-menu{border-top:1px solid var(--color-line);padding:15px 6vw 25px;background:var(--color-paper)}
  #mobile-menu a,#mobile-menu button{display:flex;justify-content:space-between;padding:15px 0;width:100%;border:0;border-bottom:1px solid var(--color-line);background:transparent;font-size:14px;text-align:left}
  @media(max-width:800px){nav{height:72px;padding-inline:6vw}.wordmark{font-size:37px}.desktop-links,.journal-link{display:none}.menu-toggle{display:flex;justify-self:start;width:44px}.announcement{font-size:9px;height:30px}.announcement a{display:none}.nav-right{gap:0}.bag-toggle{font-size:10px;gap:6px}}
</style>
