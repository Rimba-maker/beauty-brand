---
import { BRAND_STORY, image } from '~/data/content';
---

<section id="story" class="story section-shell" aria-labelledby="story-heading">
  <figure class="story-portrait">
    <img
      src={image('story')}
      alt="An editorial beauty portrait, illustrating the skin-first spirit of DEWY CO."
      width="1000"
      height="1250"
      loading="lazy"
      decoding="async"
    />
    <figcaption>A little intention. An everyday ritual.</figcaption>
  </figure>
  <div class="story-copy">
    <h2 id="story-heading" class="section-heading">{BRAND_STORY.headline}</h2>
    <div class="story-paragraphs">
      {BRAND_STORY.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <a class="text-link" href="#products">
      Meet your everyday essentials
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 12h15M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 10rem);
    padding-block: clamp(5rem, 11vw, 10rem);
  }
  .story-portrait { margin: 0; }
  .story-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--color-mauve);
  }
  figcaption {
    margin-top: 1rem;
    font-size: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
  }
  .story-copy { padding-block: 2rem; }
  .story-copy h2 { max-width: 12ch; }
  .story-paragraphs {
    margin-block: 2.25rem 2rem;
    max-width: 43ch;
    font-size: 0.9375rem;
    line-height: 1.9;
  }
  .story-paragraphs p { margin: 0; }
  .story-paragraphs p + p { margin-top: 1.4rem; }
  .story-copy .text-link { gap: 0.8rem; }
  @media (max-width: 760px) {
    .story { grid-template-columns: 1fr; gap: 2.5rem; }
    .story-portrait { width: 88%; }
    .story-copy { padding-block: 0; }
    .story-copy h2 { max-width: 15ch; }
    .story-paragraphs { max-width: 52ch; margin-top: 1.5rem; }
  }
</style>
