---
import Icon from './Icon.astro';
---
<dialog id="product-dialog" class="dialog" aria-labelledby="detail-title"><button class="dialog-close" data-close aria-label="Close product details"><Icon name="close" /></button><div class="dialog-scroll"><div id="product-detail" class="product-detail"></div></div></dialog>
<dialog id="bag-dialog" class="dialog bag-dialog" aria-labelledby="bag-title"><button class="dialog-close" data-close aria-label="Close shopping bag"><Icon name="close" /></button><div class="dialog-scroll"><div class="dialog-header"><h2 id="bag-title">Your little rituals.</h2><p class="notice">Your bag · Interactive demo</p></div><div id="bag-content" class="bag-content"></div></div></dialog>
<dialog id="quiz-dialog" class="dialog quiz-dialog" aria-labelledby="quiz-title"><button class="dialog-close" data-close aria-label="Close ritual finder"><Icon name="close" /></button><div class="dialog-scroll"><div class="dialog-header"><h2 id="quiz-title">Your kind of beauty.</h2><p class="notice">Two preferences. A few thoughtful essentials.</p></div><form id="ritual-form" class="quiz-content"><fieldset><legend>What are you in the mood for?</legend><div class="quiz-options"><label><input type="radio" name="mood" value="glow" checked /> A natural glow</label><label><input type="radio" name="mood" value="colour" /> A little colour</label></div></fieldset><fieldset><legend>How do you like your ritual?</legend><div class="quiz-options"><label><input type="radio" name="pace" value="simple" checked /> Keep it simple</label><label><input type="radio" name="pace" value="complete" /> The full ritual</label></div></fieldset><button class="button" type="submit">Discover my ritual<Icon name="arrow" /></button><p class="notice">Product discovery, not medical advice or a skin/shade assessment.</p></form><div id="quiz-results" class="quiz-content" hidden aria-live="polite"></div></div></dialog>
<div class="toast" role="status" aria-live="polite" hidden></div>
<script src="../scripts/storefront.ts"></script>
