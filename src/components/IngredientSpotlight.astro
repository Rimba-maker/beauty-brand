---
import { INGREDIENTS, image } from '~/data/content';
---

<section id="ingredients" class="ingredients" aria-labelledby="ingredients-heading">
  <div class="ingredient-layout section-shell">
    <div class="ingredient-copy">
      <h2 id="ingredients-heading" class="section-heading">Good things,<br /><em>at the heart.</em></h2>
      <p class="ingredient-intro">A closer look at three actives in our skin-first collection. Open an ingredient to get to know its role.</p>
      <div class="ingredient-list">
        {INGREDIENTS.map((ingredient, index) => (
          <details open={index === 0}>
            <summary>
              <span>{ingredient.name}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14" />
                <path class="plus-vertical" d="M12 5v14" />
              </svg>
            </summary>
            <div class="ingredient-description">
              <p>{ingredient.description}</p>
              <p class="ingredient-benefit">{ingredient.benefit}</p>
            </div>
          </details>
        ))}
      </div>
      <p class="ingredient-note">An ingredient introduction, not a promise of results. This is a fictional beauty collection.</p>
    </div>
    <figure class="botanical-image">
      <img
        src={image('botanical')}
        alt="A botanical study illustrating the collection's plant-inspired approach"
        width="1000"
        height="1250"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Inspired by botanicals. Considered for your ritual.</figcaption>
    </figure>
  </div>
</section>

<style>
  .ingredients { background: var(--color-paper); }
  .ingredient-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 9rem);
    padding-block: clamp(4.5rem, 8vw, 8rem);
  }
  .ingredient-copy h2 { max-width: 15ch; }
  .ingredient-copy h2 em { font-weight: inherit; }
  .ingredient-intro {
    max-width: 41ch;
    margin: 1.75rem 0 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.8;
  }
  .ingredient-list { border-top: 1px solid color-mix(in srgb, var(--color-espresso) 25%, transparent); }
  details { border-bottom: 1px solid color-mix(in srgb, var(--color-espresso) 25%, transparent); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 72px;
    padding-block: 1.1rem;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex-shrink: 0; }
  summary:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  details[open] .plus-vertical { display: none; }
  .ingredient-description {
    max-width: 43ch;
    padding-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .ingredient-description p { margin: 0; }
  .ingredient-description .ingredient-benefit { margin-top: 0.75rem; font-weight: 500; }
  .ingredient-note { margin-top: 1.5rem; max-width: 47ch; font-size: 0.75rem; line-height: 1.7; }
  .botanical-image { margin: 0; }
  .botanical-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--color-mauve);
  }
  figcaption { margin-top: 1rem; font-size: 0.75rem; line-height: 1.6; letter-spacing: 0.02em; }
  @media (max-width: 760px) {
    .ingredient-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .botanical-image { width: 88%; margin-left: auto; }
    .botanical-image img { aspect-ratio: 1; }
    .ingredient-intro { margin-bottom: 2rem; }
  }
</style>
